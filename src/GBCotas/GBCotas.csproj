<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One source, one build per Revit year: dotnet build -c Release -p:RevitVersion=2027 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2027'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GBCotas</AssemblyName>
    <RootNamespace>Gestaobim.Cotas</RootNamespace>
    <Version>0.5.0</Version>
    <Company>Gestão BIM</Company>
    <Product>GB Cotas</Product>
    <Description>Cotagem automática com IA: a IA planeja as cadeias de cotas, o programa posiciona e cria cotas nativas do Revit sem colisão.</Description>
    <Copyright>AGPL-3.0</Copyright>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit provides these at run time, so they are compile-time only. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure code is compiled into this assembly: the add-in is a single DLL, with nothing to resolve in Revit. -->
    <Compile Include="..\GBCotas.Core\**\*.cs" Exclude="..\GBCotas.Core\obj\**;..\GBCotas.Core\bin\**" LinkBase="Core" />
    <Compile Include="..\GBAi.Shared\**\*.cs" Exclude="..\GBAi.Shared\obj\**;..\GBAi.Shared\bin\**" LinkBase="AiShared" />
    <Compile Include="..\GBAi.Revit\**\*.cs" LinkBase="AiRevit" />
    <Compile Include="..\GBShared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
