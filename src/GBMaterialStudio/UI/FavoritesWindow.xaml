<Window x:Class="Gestaobim.MaterialStudio.UI.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão BIM | Materiais favoritos" Width="960" Height="640" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"><Window.Resources>
  <!-- Hallmark: app screen, preserved Gestao BIM brand, native WPF adaptation. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F7"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InkBrush" Color="#20343C"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#536971"/>
  <SolidColorBrush x:Key="LineBrush" Color="#C4D0D5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#155E63"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#10494D"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B373B"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F2F0"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#E8EDEF"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#D0E8E4"/>
  <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Margin="-3" RadiusX="4" RadiusY="4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="4,2"/><Setter Property="MinWidth" Value="40"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="0,6,10,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="2,3"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{StaticResource CanvasBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="2,3"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="3,6"/><Setter Property="Padding" Value="4"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Margin" Value="8,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></Style>
  <Style TargetType="Expander"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemChrome" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource CanvasBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="{StaticResource CanvasBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PatternPreviewStyle" TargetType="Border"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="28"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="4"/></Style>
</Window.Resources>
  <Grid Margin="20" Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><TextBlock Text="Materiais favoritos" Style="{StaticResource HeadingText}"/><TextBlock Text="Gestão BIM" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/></DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Label Content="Buscar material" Target="{Binding ElementName=Search}"/><TextBox x:Name="Search" ToolTip="Buscar por nome ou projeto de origem" AutomationProperties.Name="Buscar material favorito"/></StackPanel>
        <ListBox x:Name="Favorites" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Materiais favoritos">
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="{Binding PreviewBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="SelectedPreview" Width="80" Height="80" HorizontalAlignment="Left" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SelectedName" Text="Selecione um favorito" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SelectedPreviewKind" Text="A prévia e os detalhes aparecem aqui." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel></Grid>
        <TabControl Grid.Row="1" x:Name="DetailsTabs" IsEnabled="False">
          <TabItem Header="Propriedades"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"><StackPanel><TextBlock Text="Informações do material" FontWeight="SemiBold" Margin="0,0,0,12"/><Label Content="Nome"/><TextBox x:Name="DetailName" IsReadOnly="True"/><Label Content="Classe" Margin="0,8,0,0"/><TextBox x:Name="DetailClass" IsReadOnly="True"/><Label Content="Descrição" Margin="0,8,0,0"/><TextBox x:Name="DetailDescription" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60"/><TextBlock Text="Para editar estas propriedades, use Abrir editor." Style="{StaticResource SecondaryText}" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Textura"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"><StackPanel><Border x:Name="DetailTexturePreview" Height="156" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/><Label Content="Imagem de origem" Margin="0,12,0,0"/><TextBox x:Name="DetailTexturePath" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock x:Name="DetailTextureStatus" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Origem"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"><StackPanel><Label Content="Projeto"/><TextBox x:Name="DetailSource" IsReadOnly="True" TextWrapping="Wrap"/><Label Content="Arquivo RVT" Margin="0,8,0,0"/><TextBox x:Name="DetailSourcePath" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock x:Name="DetailTransferStatus" Style="{StaticResource SecondaryText}" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="2" Style="{StaticResource SecondaryText}" Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Refresh" Content="Atualizar" ToolTip="Recarregar favoritos preservando os dados salvos"/><WrapPanel Grid.Column="2" HorizontalAlignment="Right"><Button x:Name="CloseButton" Content="Fechar" IsCancel="True"/><Button x:Name="Open" Content="Abrir editor" IsEnabled="False"/><Button x:Name="ApplyFaces" Content="Aplicar nas faces" Style="{StaticResource AccentButton}" IsEnabled="False" ToolTip="Carrega o material e inicia a pintura. Clique nas faces e pressione Esc para terminar."/></WrapPanel></Grid>
  </Grid>
</Window>
