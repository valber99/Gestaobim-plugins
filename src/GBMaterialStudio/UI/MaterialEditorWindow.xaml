<Window x:Class="Gestaobim.MaterialStudio.UI.MaterialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gest&#227;o BIM | Editor de materiais" Height="820" Width="820" MinHeight="540" MinWidth="660"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Continue">
    <Window.Resources>
  <!-- Hallmark: app screen, preserved Gestao BIM brand, native WPF adaptation. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F7"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InkBrush" Color="#20343C"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#536971"/>
  <SolidColorBrush x:Key="LineBrush" Color="#C4D0D5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#155E63"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#10494D"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B373B"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F2F0"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#E8EDEF"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#D0E8E4"/>
  <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Margin="-3" RadiusX="4" RadiusY="4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="4,2"/><Setter Property="MinWidth" Value="40"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Padding" Value="0,6,10,6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="White"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="2,3"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{StaticResource CanvasBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource DisabledBrush}"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="2,3"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="3,6"/><Setter Property="Padding" Value="4"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="Margin" Value="8,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></Style>
  <Style TargetType="Expander"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemChrome" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource CanvasBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="{StaticResource CanvasBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PatternPreviewStyle" TargetType="Border"><Setter Property="Width" Value="56"/><Setter Property="Height" Value="28"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="4"/></Style>
</Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Border x:Name="ColorSwatch" Width="48" Height="48" Background="#CFDDE1" CornerRadius="6" Margin="0,0,14,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1" ToolTip="Cor atual do material. Para editar, use Alterar cor na aba Gráficos."/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MaterialName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MaterialClass" Foreground="#506974" TextWrapping="Wrap"/>
                <TextBlock x:Name="FavoriteState" Foreground="#775B10" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="2">
            <TabItem Header="Gráficos">
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="Predefinições de padrão"><StackPanel>
                            <TextBlock x:Name="PatternInfo" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button x:Name="BtnSurfaceSolid" Content="Superfície sólida" ToolTip="Aplica preenchimento sólido ao primeiro plano da superfície."/>
                                <Button x:Name="BtnSurfaceClearBg" Content="Limpar fundo da superfície" ToolTip="Remove o padrão de fundo da superfície."/>
                                <Button x:Name="BtnCutSolid" Content="Corte sólido" ToolTip="Aplica preenchimento sólido ao primeiro plano do corte."/>
                                <Button x:Name="BtnCopySurfaceToCut" Content="Copiar superfície para corte" ToolTip="Copia o padrão e a cor da superfície para o corte."/>
                            </WrapPanel>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Cor"><StackPanel>
                            <CheckBox x:Name="ChkRenderAppearance" Content="Usar aparência de renderização no sombreamento" ToolTip="Usa a aparência de renderização como cor de sombreamento."/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" x:Name="ColorPreview" Width="48" Height="48" CornerRadius="4" Margin="0,0,12,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal"><Label Content="RGB:" Width="38"/><TextBlock x:Name="ColorRGB" Style="{StaticResource ValueText}"/></StackPanel>
                                    <StackPanel Orientation="Horizontal"><Label Content="Hex:" Width="38"/><TextBlock x:Name="ColorHex" Style="{StaticResource ValueText}"/></StackPanel>
                                    <Button x:Name="BtnPickColor" Content="Alterar cor" HorizontalAlignment="Left" ToolTip="Altera a cor gráfica usada no sombreamento."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Superfície"><StackPanel>
                            <Grid x:Name="RowGraphicsTransparency"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label Content="Transparência:"/><Slider Grid.Column="1" x:Name="SliderTransparency" Maximum="100" ToolTip="Transparência de 0 a 100. Use as setas para ajustar."/><TextBlock Grid.Column="2" x:Name="ValTransparency" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                            <Grid x:Name="RowGraphicsShininess"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label Content="Brilho:"/><Slider Grid.Column="1" x:Name="SliderShininess" Maximum="128" ToolTip="Brilho de 0 a 128. Use as setas para ajustar."/><TextBlock Grid.Column="2" x:Name="ValShininess" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                            <Grid x:Name="RowGraphicsSmoothness"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label Content="Suavidade:"/><Slider Grid.Column="1" x:Name="SliderSmoothness" Maximum="100" ToolTip="Suavidade de 0 a 100. Use as setas para ajustar."/><TextBlock Grid.Column="2" x:Name="ValSmoothness" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Padrão de superfície · Primeiro plano"><StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Padrão:" Width="110"/><ComboBox x:Name="CmbSurfacePattern" Width="340" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True" ToolTip="Digite para localizar um padrão de superfície."><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Style="{StaticResource PatternPreviewStyle}" Background="{Binding PreviewBrush}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="110,4,0,8"><Border x:Name="SurfaceFgPatternPreview" Style="{StaticResource PatternPreviewStyle}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Cor:" Width="110"/><Border x:Name="SurfaceFgColorSwatch" Width="28" Height="28" CornerRadius="3" Background="Black" Margin="0,0,8,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/><Button x:Name="BtnSurfaceFgColor" Content="Alterar" ToolTip="Altera a cor do primeiro plano da superfície. Disponível quando há um padrão selecionado."/></StackPanel>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Padrão de superfície · Fundo"><StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Padrão:" Width="110"/><ComboBox x:Name="CmbSurfaceBgPattern" Width="340" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True" ToolTip="Digite para localizar um padrão de fundo da superfície."><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Style="{StaticResource PatternPreviewStyle}" Background="{Binding PreviewBrush}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="110,4,0,8"><Border x:Name="SurfaceBgPatternPreview" Style="{StaticResource PatternPreviewStyle}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Cor:" Width="110"/><Border x:Name="SurfaceBgColorSwatch" Width="28" Height="28" CornerRadius="3" Background="Black" Margin="0,0,8,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/><Button x:Name="BtnSurfaceBgColor" Content="Alterar" ToolTip="Altera a cor do fundo da superfície. Disponível quando há um padrão selecionado."/></StackPanel>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Padrão de corte · Primeiro plano"><StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Padrão:" Width="110"/><ComboBox x:Name="CmbCutPattern" Width="340" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True" ToolTip="Digite para localizar um padrão de corte."><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Style="{StaticResource PatternPreviewStyle}" Background="{Binding PreviewBrush}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="110,4,0,8"><Border x:Name="CutFgPatternPreview" Style="{StaticResource PatternPreviewStyle}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Cor:" Width="110"/><Border x:Name="CutFgColorSwatch" Width="28" Height="28" CornerRadius="3" Background="Black" Margin="0,0,8,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/><Button x:Name="BtnCutFgColor" Content="Alterar" ToolTip="Altera a cor do primeiro plano do corte. Disponível quando há um padrão selecionado."/></StackPanel>
                        </StackPanel></GroupBox>
                        <GroupBox Header="Padrão de corte · Fundo"><StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Padrão:" Width="110"/><ComboBox x:Name="CmbCutBgPattern" Width="340" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" StaysOpenOnEdit="True" ToolTip="Digite para localizar um padrão de fundo do corte."><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Style="{StaticResource PatternPreviewStyle}" Background="{Binding PreviewBrush}"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="110,4,0,8"><Border x:Name="CutBgPatternPreview" Style="{StaticResource PatternPreviewStyle}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><Label Content="Cor:" Width="110"/><Border x:Name="CutBgColorSwatch" Width="28" Height="28" CornerRadius="3" Background="Black" Margin="0,0,8,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/><Button x:Name="BtnCutBgColor" Content="Alterar" ToolTip="Altera a cor do fundo do corte. Disponível quando há um padrão selecionado."/></StackPanel>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Aparência">
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Label Content="Esquema:"/><TextBlock x:Name="SchemaName" Style="{StaticResource ValueText}"/></StackPanel>
                    <TextBlock x:Name="SchemaCapsInfo" Style="{StaticResource SecondaryText}" Margin="0,0,0,14"/>
                    <GroupBox x:Name="GrpRenderColor" Header="Cor difusa · Renderização"><StackPanel>
                        <TextBlock x:Name="TextureInfo" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="RenderColorPreview" Width="56" Height="56" CornerRadius="4" Margin="0,0,12,0" Cursor="Hand" BorderBrush="#9FB8C0" BorderThickness="1"/>
                            <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><Label Content="RGB:"/><TextBlock x:Name="RenderColorRGB" Style="{StaticResource ValueText}"/></StackPanel>
                                <WrapPanel><Button x:Name="BtnPickRenderColor" Content="Alterar cor de renderização" ToolTip="Altera a cor da aparência quando o esquema permitir."/><Button x:Name="BtnChangeTexture" Content="Alterar textura" ToolTip="Troca a imagem de textura conectada ao material."/></WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel></GroupBox>
                    <GroupBox x:Name="GrpRenderProps" Header="Propriedades de renderização"><StackPanel>
                        <Grid x:Name="RowRoughness"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label x:Name="LblRoughness" Content="Rugosidade:"/><Slider Grid.Column="1" x:Name="SliderRoughness" Maximum="100" SmallChange="1" ToolTip="Ajusta a rugosidade. Use as setas para ajustes finos."/><Border Grid.Column="2" x:Name="PreviewRoughness" Width="56" Height="20" CornerRadius="3" BorderBrush="#CFDDE1" BorderThickness="1"/><TextBlock Grid.Column="3" x:Name="ValRoughness" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                        <Grid x:Name="RowReflectivity"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label x:Name="LblReflectivity" Content="Refletividade:"/><Slider Grid.Column="1" x:Name="SliderReflectivity" Maximum="100" SmallChange="1" ToolTip="Ajusta a refletividade. Use as setas para ajustes finos."/><Border Grid.Column="2" x:Name="PreviewReflectivity" Width="56" Height="20" CornerRadius="3" BorderBrush="#CFDDE1" BorderThickness="1"/><TextBlock Grid.Column="3" x:Name="ValReflectivity" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                        <Grid x:Name="RowGlossiness"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label x:Name="LblGlossiness" Content="Brilho:"/><Slider Grid.Column="1" x:Name="SliderGlossiness" Maximum="100" SmallChange="1" ToolTip="Ajusta o brilho. Use as setas para ajustes finos."/><Border Grid.Column="2" x:Name="PreviewGlossiness" Width="56" Height="20" CornerRadius="3" BorderBrush="#CFDDE1" BorderThickness="1"/><TextBlock Grid.Column="3" x:Name="ValGlossiness" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                        <Grid x:Name="RowRenderTransp"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Label x:Name="LblRenderTransp" Content="Transparência:"/><Slider Grid.Column="1" x:Name="SliderRenderTransp" Maximum="100" SmallChange="1" ToolTip="Ajusta a transparência da aparência. Use as setas para ajustes finos."/><Border Grid.Column="2" x:Name="PreviewTransparency" Width="56" Height="20" CornerRadius="3" BorderBrush="#CFDDE1" BorderThickness="1"/><TextBlock Grid.Column="3" x:Name="ValRenderTransp" Style="{StaticResource ValueText}" HorizontalAlignment="Right"/></Grid>
                    </StackPanel></GroupBox>
                    <GroupBox x:Name="GrpTexturePreview" Header="Prévia da textura"><StackPanel>
                        <Border x:Name="TexturePreview" Width="160" Height="100" HorizontalAlignment="Left" CornerRadius="4" Background="#E8EEF0" BorderBrush="#9FB8C0" BorderThickness="1" Cursor="Hand" ToolTip="Clique para abrir o editor da textura principal."/>
                        <TextBlock x:Name="TexturePreviewInfo" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                    </StackPanel></GroupBox>
                    <GroupBox x:Name="GrpTextureEditor" Header="Imagens de textura"><StackPanel>
                        <TextBlock x:Name="TextureSlotsInfo" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Label Content="Principal:"/><TextBlock Grid.Column="1" x:Name="TxtMainTexture" TextWrapping="Wrap"/><Button Grid.Column="2" x:Name="BtnChangeMainTexture" Content="Trocar" ToolTip="Troca a imagem da textura principal."/><Button Grid.Column="3" x:Name="BtnSaveMainTexture" Content="Salvar" ToolTip="Salva uma cópia da imagem da textura principal."/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Label Content="Relevo:"/><TextBlock Grid.Column="1" x:Name="TxtBumpTexture" TextWrapping="Wrap"/><Button Grid.Column="2" x:Name="BtnChangeBumpTexture" Content="Trocar" ToolTip="Troca a imagem da textura de relevo (bump)."/><Button Grid.Column="3" x:Name="BtnSaveBumpTexture" Content="Salvar" ToolTip="Salva uma cópia da imagem da textura de relevo."/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Label Content="Recorte:"/><TextBlock Grid.Column="1" x:Name="TxtCutoutTexture" TextWrapping="Wrap"/><Button Grid.Column="2" x:Name="BtnChangeCutoutTexture" Content="Trocar" ToolTip="Troca a imagem da textura de recorte."/><Button Grid.Column="3" x:Name="BtnSaveCutoutTexture" Content="Salvar" ToolTip="Salva uma cópia da imagem da textura de recorte."/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Label Content="Transparência:"/><TextBlock Grid.Column="1" x:Name="TxtTransparencyTexture" TextWrapping="Wrap"/><Button Grid.Column="2" x:Name="BtnChangeTransparencyTexture" Content="Trocar" ToolTip="Troca a imagem da textura de transparência."/><Button Grid.Column="3" x:Name="BtnSaveTransparencyTexture" Content="Salvar" ToolTip="Salva uma cópia da imagem da textura de transparência."/></Grid>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Outras propriedades"><ItemsControl x:Name="AppearanceProps"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Label Content="{Binding Key}"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Style="{StaticResource ValueText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Identidade"><ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <GroupBox Header="Informações gerais"><StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Nome:" Width="110"/><TextBox x:Name="TxtName" Width="340" AutomationProperties.Name="Nome do material"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Descrição:" Width="110"/><TextBox x:Name="TxtDescription" Width="340" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descrição do material"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Fabricante:" Width="110"/><TextBox x:Name="TxtManufacturer" Width="340" AutomationProperties.Name="Fabricante"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Modelo:" Width="110"/><TextBox x:Name="TxtModel" Width="340" AutomationProperties.Name="Modelo"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="URL:" Width="110"/><TextBox x:Name="TxtURL" Width="340" AutomationProperties.Name="URL"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Classe:" Width="110"/><TextBox x:Name="TxtClass" Width="340" AutomationProperties.Name="Classe"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Categoria:" Width="110"/><TextBox x:Name="TxtCategory" Width="340" AutomationProperties.Name="Categoria"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Marca:" Width="110"/><TextBox x:Name="TxtMark" Width="340" AutomationProperties.Name="Marca"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Label Content="Comentários:" Width="110"/><TextBox x:Name="TxtComments" Width="340" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Comentários"/></StackPanel>
                </StackPanel></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Favoritos"><ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <GroupBox Header="Biblioteca local"><StackPanel>
                    <TextBlock x:Name="FavoritesInfo" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                    <ListBox x:Name="LstFavorites" Height="240" DisplayMemberPath="Display" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Materiais favoritos"/>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="BtnPaintFavorite" Content="Aplicar nas faces" ToolTip="Carrega o favorito selecionado e inicia a pintura de faces."/>
                        <Button x:Name="BtnImportFavorite" Content="Carregar favorito" ToolTip="Localiza na origem ou transfere o material nativo. A origem deve estar aberta no mesmo Revit."/>
                        <Button x:Name="BtnRefreshFavorites" Content="Atualizar lista" ToolTip="Recarrega os favoritos do banco local."/>
                        <Button x:Name="BtnRemoveFavorite" Content="Remover favorito" ToolTip="Remove o item selecionado do banco local de favoritos."/>
                    </WrapPanel>
                </StackPanel></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnFavorite" Content="Favoritar" ToolTip="Salva ou remove o material atual dos favoritos locais."/>
            <Button x:Name="BtnNewMaterial" Content="Novo material" ToolTip="Cria um material copiando o material atual."/>
            <Button x:Name="BtnPaint" Content="Pintar faces" ToolTip="Aplica o material em outras faces até pressionar Esc."/>
            <Button x:Name="BtnApply" Content="Aplicar" Style="{StaticResource AccentButton}" ToolTip="Salva as alterações feitas no material atual."/>
            <Button x:Name="BtnEditor" Content="Editor nativo" ToolTip="Abre o material no editor nativo do Revit."/>
            <Button x:Name="BtnClose" Content="Fechar" ToolTip="Fecha esta janela sem sair do comando."/>
        </WrapPanel>
    </Grid>
</Window>
