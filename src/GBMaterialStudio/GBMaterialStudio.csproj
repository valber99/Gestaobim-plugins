<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One source, one build per Revit year: dotnet build -c Release -p:RevitVersion=2027 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2027'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GBMaterialStudio</AssemblyName>
    <RootNamespace>Gestaobim.MaterialStudio</RootNamespace>
    <Version>0.3.1</Version>
    <Company>Gestão BIM</Company>
    <Product>GB Material Studio</Product>
    <Description>Estúdio de materiais para o Revit: editor, favoritos com biblioteca portátil, organização e material por camada.</Description>
    <Copyright>AGPL-3.0</Copyright>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit provides these at run time, so they are compile-time only. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure core is compiled into this assembly: the add-in is a single DLL, with nothing to resolve in Revit. -->
    <Compile Include="..\GBMaterialStudio.Core\**\*.cs" Exclude="..\GBMaterialStudio.Core\obj\**;..\GBMaterialStudio.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
    <Content Include="Resources\eyedropper.cur" Link="eyedropper.cur" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\gestaobim.png" Link="gestaobim.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>