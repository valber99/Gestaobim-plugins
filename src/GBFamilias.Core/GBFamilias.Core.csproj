<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gestaobim.Familias.Core</RootNamespace>
    <AssemblyName>GBFamilias.Core</AssemblyName>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sem o pacote de binarios nativos: quem hospeda escolhe (o add-in usa o winsqlite3 do Windows, os testes o e_sqlite3). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.*" />
  </ItemGroup>

</Project>
