<Window x:Class="Gestaobim.DwgExport.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GB DWG Export" Width="900" Height="660" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F8FA">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- What to export -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="SheetsRadio" Content="Folhas" IsChecked="True" Margin="0,0,16,0" Checked="OnSourceChanged"/>
                <RadioButton x:Name="ViewsRadio" Content="Vistas" Checked="OnSourceChanged"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Limpar" Margin="6,0,0,0" MinWidth="60" Click="OnClearAll"/>
                <Button x:Name="AllButton" DockPanel.Dock="Right" Content="Marcar todas" Margin="6,0,0,0" Click="OnCheckAll"/>
                <TextBox x:Name="SearchBox" Padding="4,4" ToolTip="Buscar por número, nome ou tipo" TextChanged="OnSearchChanged"/>
            </DockPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#FF555B66"/>
            <ListView x:Name="ItemsList" SelectionMode="Extended" BorderBrush="#FFC9CED6">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="OnItemToggled" Unchecked="OnItemToggled"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="NumberColumn" Header="Número" Width="110" DisplayMemberBinding="{Binding Number}"/>
                        <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn x:Name="GroupColumn" Header="Tipo" Width="120" DisplayMemberBinding="{Binding Group}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <!-- How to export -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Resultado">
                    <StackPanel>
                        <RadioButton x:Name="LayoutsRadio" Content="Um desenho, um layout por folha" IsChecked="True" Checked="OnModeChanged"/>
                        <RadioButton x:Name="ModelRadio" Content="Um desenho, folhas no model space" Checked="OnModeChanged"/>
                        <RadioButton x:Name="SingleRadio" Content="Um desenho, um só layout com tudo" Checked="OnModeChanged"/>
                        <RadioButton x:Name="SeparateRadio" Content="Um arquivo por folha (sem juntar)" Checked="OnModeChanged"/>
                        <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF555B66"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Arquivo">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <ComboBox x:Name="FormatBox" Grid.Column="1" Margin="0,0,0,6">
                            <ComboBoxItem Content="DWG" IsSelected="True"/>
                            <ComboBoxItem Content="DXF"/>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="Nome" VerticalAlignment="Center" Margin="0,0,10,6"/>
                        <ComboBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                            <ComboBoxItem Content="Número - Nome da folha" IsSelected="True"/>
                            <ComboBoxItem Content="Somente o número"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="Revit" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="SetupBox" Grid.Row="2" Grid.Column="1"
                                  ToolTip="Configuração de exportação DWG do projeto (camadas, unidades, texto)"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Pasta de destino">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Procurar..." Margin="6,0,0,0" MinWidth="80" Click="OnBrowse"/>
                        <TextBox x:Name="FolderBox" Padding="4,4"/>
                    </DockPanel>
                </GroupBox>

                <CheckBox x:Name="OpenBox" Content="Abrir a pasta ao terminar" IsChecked="True"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="Exportar" IsDefault="True" Margin="0,0,8,0" Click="OnExport"/>
                <Button Content="Fechar" IsCancel="True" Click="OnClose"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF555B66" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
