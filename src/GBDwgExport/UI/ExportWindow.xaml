<Window x:Class="Gestaobim.DwgExport.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GB DWG Export" Width="960" Height="700" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="#FFF1F5F9" Foreground="#FF1E293B">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1E293B"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1677FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF0958D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF003EB3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF335C81"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF284B7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabecalho -->
        <Border DockPanel.Dock="Top" Background="#FF12263A" Padding="18,13">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" Content="Exportar config." Margin="0,0,8,0" Click="OnExportSettings"
                            ToolTip="Salva as configurações atuais num arquivo .zip para levar a outra máquina"/>
                    <Button Style="{StaticResource HeaderButton}" Content="Importar config." Click="OnImportSettings"
                            ToolTip="Carrega configurações a partir de um arquivo .zip"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="GB DWG Export" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Exporte folhas ou vistas para DWG/DXF em layouts mesclados, model space ou arquivos separados — sem AutoCAD"
                               Foreground="#FFC4D6E8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Rodape -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="Exportar" IsDefault="True" Margin="0,0,8,0" Click="OnExport"/>
                    <Button Content="Fechar" IsCancel="True" Click="OnClose"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FFB91C1C" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Conteudo principal -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="345"/>
            </Grid.ColumnDefinitions>

            <!-- Esquerda: Folhas / Vistas -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="SheetsRadio" Content="Folhas" FontWeight="SemiBold" IsChecked="True" Margin="0,0,18,0" Checked="OnSourceChanged"/>
                            <RadioButton x:Name="ViewsRadio" Content="Vistas" FontWeight="SemiBold" Checked="OnSourceChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="12.5"/>
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Limpar" Margin="6,0,0,0" MinWidth="64" Click="OnClearAll"/>
                        <Button x:Name="AllButton" DockPanel.Dock="Right" Content="Marcar todas" Margin="6,0,0,0" Click="OnCheckAll"/>
                        <TextBox x:Name="SearchBox" Padding="8,6" BorderBrush="#FFCBD5E1" ToolTip="Buscar por número, nome ou tipo" TextChanged="OnSearchChanged"/>
                    </DockPanel>

                    <ListView x:Name="ItemsList" SelectionMode="Extended" BorderBrush="#FFE2E8F0" Background="#FFF8FAFC">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="OnItemToggled" Unchecked="OnItemToggled"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="NumberColumn" Header="Número" Width="105" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Nome" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn x:Name="GroupColumn" Header="Tipo" Width="120" DisplayMemberBinding="{Binding Group}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Direita: Configuracao -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Modo de saída" FontWeight="SemiBold" FontSize="13.5" Foreground="#FF0F172A" Margin="0,0,0,8"/>
                            <RadioButton x:Name="LayoutsRadio" Content="Um desenho, um layout por folha" IsChecked="True" Checked="OnModeChanged"/>
                            <RadioButton x:Name="ModelRadio" Content="Um desenho, tudo no model space" Checked="OnModeChanged"/>
                            <RadioButton x:Name="SingleRadio" Content="Um desenho, um só layout com tudo" Checked="OnModeChanged"/>
                            <RadioButton x:Name="SeparateRadio" Content="Um arquivo por folha ou vista (sem juntar)" Checked="OnModeChanged"/>
                            <Border Background="#FFF8FAFC" CornerRadius="5" Padding="8,6" Margin="0,8,0,0">
                                <TextBlock x:Name="ModeHint" TextWrapping="Wrap" FontSize="11.5" Foreground="#FF475569"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Arquivo" FontWeight="SemiBold" FontSize="13.5" Foreground="#FF0F172A" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#FF475569"/>
                                <ComboBox x:Name="FormatBox" Grid.Column="1" Margin="0,0,0,8" Padding="6,4">
                                    <ComboBoxItem Content="DWG" IsSelected="True"/>
                                    <ComboBoxItem Content="DXF"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Nome" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#FF475569"/>
                                <ComboBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="6,4">
                                    <ComboBoxItem Content="Número - Nome da folha" IsSelected="True"/>
                                    <ComboBoxItem Content="Somente o número"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="Revit" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF475569"/>
                                <ComboBox x:Name="SetupBox" Grid.Row="2" Grid.Column="1" Padding="6,4"
                                          ToolTip="Configuração de exportação DWG do projeto (camadas, unidades, texto)"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Pasta de destino" FontWeight="SemiBold" FontSize="13.5" Foreground="#FF0F172A" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Procurar…" Margin="6,0,0,0" MinWidth="82" Click="OnBrowse"/>
                                <TextBox x:Name="FolderBox" Padding="7,5" BorderBrush="#FFCBD5E1"/>
                            </DockPanel>
                            <CheckBox x:Name="OpenBox" Content="Abrir a pasta ao terminar" IsChecked="True" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
