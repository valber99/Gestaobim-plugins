<Window x:Class="Gestaobim.Familias.UI.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GB Famílias" Width="1320" Height="820" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="13"
        Background="#FFF7F8FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF204E80"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SideExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="IsExpanded" Value="False"/>
        </Style>
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFE0A100"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Favoritar"/>
        </Style>
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#FFEEF3F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FF2B6CB0"/>
                                <Setter TargetName="Frame" Property="Background" Value="#FFE3EEFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate">
            <Border Width="150" Height="188" Margin="3" Padding="6" Background="White" BorderBrush="#FFDDE1E7"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FFF1F3F6" CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="sem preview" Foreground="#FF9AA1AD" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="{Binding NoPreview, Converter={StaticResource BoolVis}}"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#99204E80" CornerRadius="3"
                                    Padding="4,0" Margin="3" ToolTip="Versão do Revit em que a família foi salva">
                                <TextBlock Text="{Binding VersionBadge}" Foreground="White" FontSize="10"/>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#FF2F855A" CornerRadius="3"
                                    Padding="4,0" Margin="3" ToolTip="Já está na sua pasta de downloads"
                                    Visibility="{Binding ShowDownloaded, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="✓ baixada" Foreground="White" FontSize="10"/>
                            </Border>
                            <Button Style="{StaticResource StarButton}" Content="{Binding StarText}" Tag="{Binding}"
                                    Click="OnStarClick" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="34" FontWeight="SemiBold" Margin="0,6,0,0" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="#FF6B7280" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FacetTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Text}"
                      Checked="OnFacetToggled" Unchecked="OnFacetToggled"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de busca -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Configurações" Margin="8,0,0,0" Click="OnSettings"/>
            <Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Atualizar catálogo" Margin="8,0,0,0" Click="OnSync" Visibility="Collapsed"
                    ToolTip="Procura no servidor um catálogo novo (famílias, previews e dados de busca)"/>
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Limpar filtros" Margin="8,0,0,0" Click="OnClearFilters"/>
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" SelectionChanged="OnSortChanged"
                      ToolTip="Ordem dos resultados">
                <ComboBoxItem Content="Relevância" IsSelected="True"/>
                <ComboBoxItem Content="Nome"/>
                <ComboBoxItem Content="Categoria"/>
            </ComboBox>
            <Border x:Name="ImageChip" DockPanel.Dock="Right" Visibility="Collapsed" Background="#FFE3EEFA" BorderBrush="#FF2B6CB0"
                    BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ImageChipText" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    <Button Content="✕" MinWidth="0" Padding="6,0" Margin="6,0,0,0" BorderThickness="0" Background="Transparent"
                            Click="OnClearImage" ToolTip="Remover a busca por imagem"/>
                </StackPanel>
            </Border>
            <Button x:Name="ImageButton" DockPanel.Dock="Right" Content="Buscar por imagem…" Margin="8,0,0,0" Click="OnPickImage"
                    ToolTip="Acha famílias parecidas com uma imagem (foto, print ou desenho)"/>
            <CheckBox x:Name="AiCheck" DockPanel.Dock="Right" Content="Busca por IA" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsChecked="True" Checked="OnAiToggled" Unchecked="OnAiToggled"
                      ToolTip="Entende o sentido da busca, não só as palavras (ex.: &quot;lavatório&quot; acha pias)."/>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="6,5" FontSize="14" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"/>
                <TextBlock x:Name="SearchHint" Text="Buscar famílias: nome, material, cor, ambiente…" Foreground="#FF9AA1AD"
                           Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"/>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Filtros e categorias -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <Expander Header="Coleções" IsExpanded="True" Style="{StaticResource SideExpander}">
                        <StackPanel Margin="4,6,0,0">
                            <ListBox x:Name="CollectionsList" MaxHeight="170" BorderBrush="#FFC9CED6" SelectionChanged="OnCollectionChanged"
                                     DisplayMemberPath="Text"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Nova coleção" Click="OnNewCollection" Margin="0,0,6,0"/>
                                <Button x:Name="DeleteCollectionButton" Content="Excluir" Click="OnDeleteCollection" IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Categorias" IsExpanded="True" Style="{StaticResource SideExpander}">
                        <TreeView x:Name="CategoryTree" Margin="4,6,0,0" BorderThickness="0" Background="Transparent" MaxHeight="300">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Text}"
                                              Checked="OnCategoryToggled" Unchecked="OnCategoryToggled"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Expander>
                    <StackPanel x:Name="FacetsHost"/>
                    <CheckBox x:Name="OnlyPreviewCheck" Content="Somente com preview" Margin="4,8,0,0" Checked="OnOptionChanged"
                              Unchecked="OnOptionChanged"/>
                    <CheckBox x:Name="OnlyDownloadedCheck" Content="Somente baixadas" Margin="4,4,0,0" Checked="OnOptionChanged"
                              Unchecked="OnOptionChanged" Visibility="Collapsed"
                              ToolTip="Mostra só as famílias que já estão na sua pasta de downloads (funcionam sem internet)"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Resultados -->
            <DockPanel Grid.Column="2">
                <Button x:Name="ShowMoreButton" DockPanel.Dock="Bottom" Content="Mostrar mais" Margin="0,8,0,0" HorizontalAlignment="Center"
                        Visibility="Collapsed" Click="OnShowMore" Padding="24,6"/>
                <Grid>
                    <ListBox x:Name="ResultsList" BorderBrush="#FFC9CED6" Background="White" SelectionMode="Single"
                             ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource CardItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                             SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnResultDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="Nenhuma família encontrada." Foreground="#FF6B7280" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <!-- Detalhes -->
            <Border Grid.Column="4" Background="White" BorderBrush="#FFC9CED6" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" Margin="14">
                        <TextBlock x:Name="DetailsHint" Text="Selecione uma família para ver os detalhes." Foreground="#FF6B7280"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="DetailsBody" Visibility="Collapsed">
                            <Border Background="#FFF1F3F6" CornerRadius="6" Height="190">
                                <Image x:Name="DetailImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock x:Name="DetailCategory" Foreground="#FF2B6CB0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <WrapPanel x:Name="TagsPanel" Margin="0,8,0,0"/>
                            <TextBlock x:Name="DetailMeta" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FF374151" LineHeight="20"/>
                            <Border x:Name="CompatBox" Visibility="Collapsed" Background="#FFFFF4E0" BorderBrush="#FFE0A100"
                                    BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                                <TextBlock x:Name="CompatText" TextWrapping="Wrap" FontSize="12"/>
                            </Border>
                            <TextBlock x:Name="DetailPath" Foreground="#FF9AA1AD" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Button x:Name="InsertButton" Style="{StaticResource PrimaryButton}" Content="Inserir no projeto"
                                    Margin="0,14,0,0" Click="OnInsert"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FavoriteButton" Content="☆ Favoritar" Click="OnFavoriteClick"/>
                                <Button x:Name="CollectionButton" Grid.Column="2" Content="Coleção ▾" Click="OnCollectionMenu"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SimilarButton" Content="Ver parecidas" Click="OnSimilar"
                                        ToolTip="Acha famílias com aparência parecida usando a busca por IA"/>
                                <Button x:Name="FolderButton" Grid.Column="2" Content="Abrir pasta" Click="OnOpenFolder"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra de status -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="AccountButton" DockPanel.Dock="Right" Content="Entrar" Margin="12,0,0,0" MinWidth="0" Padding="10,1"
                    Click="OnAccount" Visibility="Collapsed"/>
            <TextBlock x:Name="AccountText" DockPanel.Dock="Right" Foreground="#FF6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="AiStatusText" DockPanel.Dock="Right" Foreground="#FF6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="Cancelar" Margin="8,0,0,0" MinWidth="0" Padding="10,1"
                    Click="OnCancelDownload" Visibility="Collapsed"/>
            <ProgressBar x:Name="DownloadBar" DockPanel.Dock="Right" Width="160" Height="12" Margin="12,0,0,0" Visibility="Collapsed"
                         VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="#FF374151" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
