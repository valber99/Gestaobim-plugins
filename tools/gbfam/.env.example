# O banco e um arquivo SQLite: gbfam.sqlite nesta pasta. Para mudar o local:
# GBFAM_DB=F:\Projetos\Gestaobim-plugins\banco_familias\gbfam.sqlite

# Chave da API do Claude. O gbfam tambem le a variavel `key` de F:\Projetos\.env.
# ANTHROPIC_API_KEY=

# Onde guardar os modelos ONNX baixados (~400 MB).
# GBFAM_MODELS=F:\Projetos\Gestaobim-plugins\banco_familias\.models

