# Copie para .env (que esta no .gitignore) e preencha.
# Postgres 16 local: porta 5433, banco criado com `CREATE DATABASE gbfamilias;`
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5433/gbfamilias

# Chave da API do Claude. O gbfam tambem le a variavel `key` de F:\Projetos\.env.
# ANTHROPIC_API_KEY=

# Onde guardar os modelos ONNX baixados (~400 MB). Padrao: .models na pasta atual.
# GBFAM_MODELS=F:\Projetos\Gestaobim-plugins\banco_familias\.models
